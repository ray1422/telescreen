{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Telescreen configuration v1",
  "description": "Structural validation only; docs/config.md specifies semantic checks and driver contracts.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "computers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/computer"
      }
    }
  },
  "required": [
    "version",
    "computers"
  ],
  "additionalProperties": false,
  "$defs": {
    "handoff": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      },
      "required": [
        "steps"
      ],
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "portal-match": {
          "$ref": "#/$defs/match"
        },
        "input-target": {
          "$ref": "#/$defs/resolution"
        },
        "handoff": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/handoff"
          }
        },
        "verify": {
          "$ref": "#/$defs/verifier"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "computer": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Plain text that the prompt verifier of this computer shows, for example its copy/paste shortcuts."
        },
        "clipboard": {
          "type": "object",
          "description": "Clipboard sync of this computer (v0.2.0, CLIP-1).",
          "properties": {
            "text": {
              "type": "boolean",
              "default": true,
              "description": "The start value of the text clipboard switch. The control window can change it while the app runs."
            }
          },
          "additionalProperties": false
        },
        "scroll-speed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10,
          "default": 1,
          "description": "This computer multiplies each scroll that it receives from a source by this number (IN-14)."
        },
        "disabled-quirks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["kwin-button-scroll"]
          },
          "default": [],
          "description": "The platform workarounds that this computer does not use. Each workaround is on, unless this list has it (IN-16)."
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Absolute directories to find a program name with no '/'. Default: PATH of the login shell."
        },
        "endpoint": {
          "type": "object",
          "properties": {
            "host": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "discovery": {
              "enum": [
                "mdns"
              ]
            }
          },
          "required": [
            "port"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "host"
              ]
            },
            {
              "required": [
                "discovery"
              ]
            }
          ]
        },
        "devices": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/device"
          }
        }
      },
      "required": [
        "endpoint",
        "devices"
      ],
      "additionalProperties": false
    },
    "timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000,
      "description": "Default 5000; 60000 for verify."
    },
    "command": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "A string (split by POSIX shell rules, with no shell) or a list, as in Docker Compose."
    },
    "run": {
      "type": "object",
      "properties": {
        "driver": {
          "enum": [
            "exec",
            "command"
          ]
        },
        "timeout-ms": {
          "$ref": "#/$defs/timeout"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "driver",
        "command"
      ],
      "additionalProperties": false
    },
    "command-run": {
      "type": "object",
      "properties": {
        "driver": {
          "enum": [
            "command"
          ]
        },
        "timeout-ms": {
          "$ref": "#/$defs/timeout"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "driver",
        "command"
      ],
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "properties": {
        "driver": {
          "const": "prompt"
        }
      },
      "required": [
        "driver"
      ],
      "additionalProperties": false
    },
    "extension": {
      "type": "object",
      "properties": {
        "driver": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9.-]*$"
        },
        "timeout-ms": {
          "$ref": "#/$defs/timeout"
        },
        "options": {
          "type": "object"
        }
      },
      "required": [
        "driver",
        "options"
      ],
      "additionalProperties": false
    },
    "display": {
      "description": "The built-in display matcher: the metadata of a display has each value.",
      "type": "object",
      "properties": {
        "driver": {
          "const": "display"
        },
        "match": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        }
      },
      "required": [
        "driver",
        "match"
      ],
      "additionalProperties": false
    },
    "match": {
      "description": "portal-match.",
      "oneOf": [
        {
          "$ref": "#/$defs/run"
        },
        {
          "$ref": "#/$defs/display"
        },
        {
          "$ref": "#/$defs/extension"
        }
      ]
    },
    "condition": {
      "description": "handoff steps.",
      "oneOf": [
        {
          "$ref": "#/$defs/run"
        },
        {
          "$ref": "#/$defs/extension"
        }
      ]
    },
    "resolution": {
      "description": "input-target: it returns a display token, so exec is not possible.",
      "oneOf": [
        {
          "$ref": "#/$defs/command-run"
        },
        {
          "$ref": "#/$defs/display"
        },
        {
          "$ref": "#/$defs/extension"
        }
      ]
    },
    "verifier": {
      "description": "verify on the destination (ADR 0009).",
      "oneOf": [
        {
          "$ref": "#/$defs/run"
        },
        {
          "$ref": "#/$defs/prompt"
        },
        {
          "$ref": "#/$defs/extension"
        }
      ]
    }
  }
}
