#!/bin/sh
# The entry point of the Telescreen AppImage (packaging/appimage/build.sh).

configure_environment() {
  here=$(dirname "$(readlink -f "$0")")
  # Use the bundled KDE style unless the user selected another style.
  export QT_QUICK_CONTROLS_STYLE="${QT_QUICK_CONTROLS_STYLE:-org.kde.desktop}"
  # Search bundled data before the host's icon themes and fonts.
  export XDG_DATA_DIRS="$here/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
}

launch() {
  if [ -x "$here/usr/bin/telescreen" ]; then
    exec "$here/usr/bin/telescreen" "$@"
  fi
  # Preview.qml reads the fixture with XMLHttpRequest.
  export QML_XHR_ALLOW_FILE_READ=1
  exec "$here/usr/bin/qml" -a widget "$here/usr/share/telescreen/qml/preview/Preview.qml" -- "$@"
}

configure_environment
launch "$@"
